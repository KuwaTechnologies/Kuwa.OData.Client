<Project>

	<!-- Project classification -->
	<PropertyGroup>
		<IsPrimaryProject Condition="'$(MSBuildProjectName)' == 'Kuwa.OData.Client'">true</IsPrimaryProject>
		<IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.EndsWith('.Tests.Integration'))">true</IsTestProject>
		<IsTestSupportProject Condition="$(MSBuildProjectName.EndsWith('.Tests.TestServer'))">true</IsTestSupportProject>
		<IsBenchmarkProject Condition="$(MSBuildProjectName.EndsWith('.Benchmarks'))">true</IsBenchmarkProject>
	</PropertyGroup>

	<!-- Compilation -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>14</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<ChecksumAlgorithm>SHA256</ChecksumAlgorithm>
		<NeutralLanguage>en-US</NeutralLanguage>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
	</PropertyGroup>

	<!-- Package metadata (applies to the packable project) -->
	<PropertyGroup>
		<Product>Kuwa.OData.Client</Product>
		<Authors>Kuwa Technologies</Authors>
		<Company>Kuwa Technologies</Company>
		<Copyright>Copyright © 2012-2026 Kuwa Technologies and contributors. Licensed under the MIT License.</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>kuwa-odata-client.png</PackageIcon>
		<PackageProjectUrl>https://github.com/KuwaTechnologies/Kuwa.OData.Client</PackageProjectUrl>
		<RepositoryUrl>https://github.com/KuwaTechnologies/Kuwa.OData.Client</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>odata;odata-v4;odata-client;kuwaodata</PackageTags>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<!-- Strong naming -->
	<PropertyGroup>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Kuwa.OData.Client.snk</AssemblyOriginatorKeyFile>
		<StrongNamePublicKey></StrongNamePublicKey>
	</PropertyGroup>

	<!-- Primary (shipped) project -->
	<PropertyGroup Condition="'$(IsPrimaryProject)' == 'true'">
		<IsPackable>true</IsPackable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<IsTrimmable>false</IsTrimmable>
		<IsAotCompatible>false</IsAotCompatible>
	</PropertyGroup>

	<!-- Everything else -->
	<PropertyGroup Condition="'$(IsPrimaryProject)' != 'true'">
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- Test projects -->
	<PropertyGroup Condition="'$(IsTestProject)' == 'true'">
		<NoWarn>$(NoWarn);CA1001;CA1031;CA1062;CA1303;CA1304;CA1305;CA1307;CA1309;CA1311;CA1707;CA1711;CA1716;CA1720;CA1806;CA1812;CA1816;CA1822;CA1825;CA1859;CA1861;CA1862;CA2000;CA2007;CA2227;CA2234;CA2263;CA5394;IDE0005;xUnit1004;xUnit1051</NoWarn>
		<OutputType>Exe</OutputType>
		<RollForward>Major</RollForward>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<TestingPlatformCaptureOutput>false</TestingPlatformCaptureOutput>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsTestSupportProject)' == 'true' Or '$(IsBenchmarkProject)' == 'true'">
		<NoWarn>$(NoWarn);CA1001;CA1031;CA1062;CA1303;CA1305;CA1307;CA1309;CA1707;CA1711;CA1716;CA1720;CA1806;CA1812;CA1816;CA1822;CA1825;CA1861;CA1862;CA2000;CA2007;CA2227;CA2234;CA5394</NoWarn>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsTestProject)' == 'true'">
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
		<PackageReference Include="AwesomeAssertions" />
		<Using Include="Xunit" />
		<Using Include="AwesomeAssertions" />
	</ItemGroup>

	<ItemGroup Condition="'$(IsPrimaryProject)' == 'true'">
		<None Include="$(MSBuildThisFileDirectory)kuwa-odata-client.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
